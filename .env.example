# Supabase Project Credentials (Dapatkan dari Dashboard Supabase > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Nomor WhatsApp Admin Toko Resmi (Gunakan kode negara tanpa tanda '+', contoh: 6281234567890)
NEXT_PUBLIC_ADMIN_WA=6281234567890

# Optional: Password/PIN Akses Dashboard Admin (Default: admin123)
NEXT_PUBLIC_ADMIN_PIN=admin123
